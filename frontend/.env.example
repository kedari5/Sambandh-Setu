# Sambandh Setu app configuration (Expo).
# Web on Vercel: leave EXPO_PUBLIC_API_URL empty; the app calls /api on the same site.
# Local localhost web development defaults to http://localhost:5000/api.
# Set this explicitly for LAN devices or another API host.
# Android/iOS builds: the deployed API, e.g. https://sambandh-setu.vercel.app/api
EXPO_PUBLIC_API_URL=
